# Normalise line endings in the repository; Windows scripts keep CRLF.
* text=auto eol=lf
*.bat text eol=crlf
gradlew text eol=lf

# Binary assets: never touch their bytes.
*.traineddata binary
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.ttf binary
*.webp binary
*.icc binary
*.apk binary
