<!-- Lint checks that do not apply to this project, each with its reason (2.0 bug hunt, 2026-11-15).
     Every other finding is fixed in the code or suppressed at its line with a comment. -->
<lint>
    <!-- Dependency and toolchain versions change only between releases, together with
         gradle/verification-metadata.xml (checksums verified against the published ones); a release
         candidate keeps the versions its tests and SBOM were made with. -->
    <issue id="GradleDependency" severity="ignore" />
    <issue id="NewerVersionAvailable" severity="ignore" />
    <issue id="AndroidGradlePluginVersion" severity="ignore" />
    <!-- x86_64 was dropped on purpose in the 1.5 OCR plan (no official MNN x86_64 Android build,
         +3.4 MB); the app targets phones (arm64-v8a, armeabi-v7a). -->
    <issue id="ChromeOsAbiSupport" severity="ignore" />
    <!-- The app ships as a signed APK (GitHub, Obtainium), never as an app bundle split by language. -->
    <issue id="AppBundleLocaleChanges" severity="ignore" />
    <!-- minSdk is 24: the framework ExifInterface already has the fixes the androidx copy back-ports
         to older versions, and using it avoids a new dependency. -->
    <issue id="ExifInterface" severity="ignore" />
</lint>
